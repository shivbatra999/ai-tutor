rules_version = 2;

service cloud.firestore {
  match /databases/{database}/documents {
    // Allow read/write access to all users for now, for local development.
    // TODO: Restrict this for production based on user roles and data ownership.
    match /{document=**} {
      allow read, write: if request.auth != null; // Authenticated users can read/write anything
    }
  }
}
